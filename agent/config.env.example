# ── Cấu hình Local Agent ──────────────────────────────────────────────
# Sao chép file này thành "config.env" và điều chỉnh khi cần

# Port HTTP của agent trên máy khách hàng
AGENT_PORT=8099

# Chỉ cho phép loopback. Không đổi thành 0.0.0.0 hoặc IP LAN.
AGENT_HOST=127.0.0.1

# Số request GDT đồng thời tối đa (1..10)
MAX_CONCURRENT=10

# Số hóa đơn trên mỗi trang GDT. Agent tự giảm size nếu GDT cắt response.
GDT_PAGE_SIZE=30

# Giới hạn request HTTP đầu vào và thời gian chờ khi agent quá tải
MAX_HTTP_CONCURRENT=10
HTTP_QUEUE_TIMEOUT=5

# Chi tiết hóa đơn: số worker đồng thời, mặc định 3 (không vượt MAX_CONCURRENT).
# Khi gặp HTTP 429, agent tự giảm còn 1 request và cooldown chung.
DETAIL_WORKERS=3

# Mỗi detail tối đa 2 lần gọi, mỗi lần tối đa 25 giây
DETAIL_MAX_ATTEMPTS=2
DETAIL_REQUEST_TIMEOUT=25

# GDT 429: cooldown chung 10 giây, dừng batch khi có 4 lần 429 liên tiếp
DETAIL_429_COOLDOWN=10
DETAIL_429_ABORT_AFTER=4

# Giới hạn tổng thời gian lấy chi tiết cho một batch (giây)
# Khi hết hạn sẽ trả HTTP 207 với các hóa đơn lỗi để lấy lại sau
DETAIL_BATCH_TIMEOUT=3600

# Số hóa đơn tối đa nhận trong một request /fetch-invoice-details
MAX_DETAIL_ITEMS=5000
MAX_REQUEST_BODY_MB=16

# Tùy chọn: đường dẫn CA bundle nội bộ. Để trống sẽ dùng CA tin cậy mặc định.
GDT_CA_BUNDLE=
