# ── Cấu hình Local Agent ──────────────────────────────────────────────
# Cấu hình đang dùng cho Local Agent

# Port HTTP của agent trên máy khách hàng
AGENT_PORT=8099

# Chỉ cho phép loopback để credentials GDT không đi qua LAN
AGENT_HOST=127.0.0.1

# Số request GDT đồng thời tối đa (1..10)
MAX_CONCURRENT=10

# Số hóa đơn trên mỗi trang GDT. Agent tự giảm size nếu GDT cắt response.
GDT_PAGE_SIZE=30

# Giới hạn request HTTP đầu vào và thời gian chờ khi agent quá tải
MAX_HTTP_CONCURRENT=10
HTTP_QUEUE_TIMEOUT=5

# Số hóa đơn tối đa nhận trong một request /fetch-invoice-details
MAX_DETAIL_ITEMS=5000
MAX_REQUEST_BODY_MB=16

# Tùy chọn: đường dẫn CA bundle nội bộ. Để trống sẽ dùng CA tin cậy mặc định.
GDT_CA_BUNDLE=
